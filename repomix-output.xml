  "low_level_keywords": ["viêm phổi", "suy hô hấp"],
  "high_level_keywords": [
    "biến chứng của viêm phổi",
    "diễn tiến viêm phổi gây suy hô hấp",
    "biến chứng hô hấp nặng"
  ]
}

