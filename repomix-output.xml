        )

        all_records.append(
            {
                "chunk": {
                    "chunk_id": chunk.chunk_id,
                    "chunk_index": chunk.chunk_index,
                    "article_id": chunk.article_id,
                    "title": chunk.title,
                    "section": chunk.section,
                    "subsection": chunk.subsection,
