        self,
        relation_types: list[str] | None = None,
        limit: int = 100_000,
    ) -> list[EntityAdjacencyEdge]:
        """
        Export adjacency toàn graph cho PPR.
        Dùng khi graph vừa/nhỏ.
        """
        params = {
            "relation_types": relation_types,
            "limit": limit,
