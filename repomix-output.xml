            "article_title",
            "url",
            "md_path",
            "error",
            "entity_count",
            "relation_count",
            "useful_relation_count",
            "suspicious_evidence_count",
            "keyword_issue_count",
            "orphan_measure_count",
            "relation_type_counts",
            "expected_term_hits",
        ],
    )
    write_csv(
        out_dir / "targeted_relations.csv",
        all_relation_rows,
        [
            "target_id",
            "target_label",
            "article_title",
            "url",
            "md_path",
